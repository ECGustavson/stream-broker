{
  "scales": [
    {
      "name": "Scale680",
      "mode": "listen",
      "ip": "192.168.10.12",
      "port": 10005,
      "enabled": true,
      "description": "680 - Rice Lake stream format",
      "units": { "L": "LB", "K": "KG", "P": "LB", "S": "KG" },
      "stream_timeout_seconds": 5
    }
  ],
  "opc": {
    "endpoint": "opc.tcp://0.0.0.0:4842/broker",
    "namespace": "http://floweigh/scalebroker",
    "pki_dir": "pki",
    "allow_no_security": true
  },
  "logging": {
    "log_dir": "logs",
    "max_bytes": 5242880,
    "backup_count": 10
  }
}
